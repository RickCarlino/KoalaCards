// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../koala/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                         String                      @id @default(cuid())
  name                       String?
  email                      String?                     @unique
  emailVerified              DateTime?
  lastSeen                   DateTime?
  image                      String?
  createdAt                  DateTime                    @default(now())
  accounts                   Account[]
  sessions                   Session[]
  userSettings               UserSettings?
  Card                       Card[]
  Deck                       Deck[]
  deckFsrsConfigs            DeckFsrsConfig[]
  cardReviewLogs             CardReviewLog[]
  writingSubmissions         WritingSubmission[]         // Added relation to WritingSubmission
  quizResults                QuizResult[]
  readerInstapaperCredential ReaderInstapaperCredential?
  readerArticles             ReaderArticle[]
  readerArticleHighlights    ReaderArticleHighlight[]
  readerBooks                ReaderBook[]
  readerBookProgresses       ReaderBookProgress[]
  readerBookAnnotations      ReaderBookAnnotation[]
  languageExchangeLink       LanguageExchangeLink?
  languageExchangePresence   LanguageExchangePresence?
  languageExchangeCalls      LanguageExchangeCall[]     @relation("LanguageExchangeCallLearner")
}

model UserSettings {
  id                 Int      @id @default(autoincrement())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String   @unique
  // Audio playback speed min: 0.5 max: 2
  playbackSpeed      Float    @default(1)
  // Cards/day max
  cardsPerDayMax     Int      @default(7)
  reviewTakeCount    Int      @default(5)
  requestedRetention Float    @default(0.73)
  // Value from 0 to 1 representing the percentage liklihood
  // of a random playback of the user's audio.
  playbackPercentage Float    @default(0.125)
  responseTimeoutSeconds Int  @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  dailyWritingGoal   Int      @default(150)
  writingFirst       Boolean  @default(false) // Always quiz writing before reviewing cards
  maxLapses          Int      @default(0)
  dueCardsEmailNotifications Boolean @default(false)
  languageExchangeAvailable Boolean @default(false)
  readerFontSize Int @default(20)
  readerLineHeight Float @default(1.75)
  readerReadingWidth Int @default(800)
  dueCardsEmailNotificationSentAt DateTime?
}

enum LanguageExchangeCallStatus {
  RINGING
  ACTIVE
  ENDED
  DECLINED
  CANCELLED
  EXPIRED
}

model LanguageExchangeLink {
  id        Int                    @id @default(autoincrement())
  userId    String                 @unique
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String                 @unique @db.VarChar(64)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  calls     LanguageExchangeCall[]
}

model LanguageExchangePresence {
  id         Int      @id @default(autoincrement())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaseId    String   @db.VarChar(64)
  isVisible  Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
}

model LanguageExchangeCall {
  id                 Int                        @id @default(autoincrement())
  linkId             Int
  link               LanguageExchangeLink       @relation(fields: [linkId], references: [id], onDelete: Cascade)
  learnerId          String
  learner            User                       @relation("LanguageExchangeCallLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  guestToken         String                     @unique @db.VarChar(64)
  status             LanguageExchangeCallStatus @default(RINGING)
  offerSdp           Json?
  answerSdp          Json?
  guestHeartbeatAt   DateTime                   @default(now())
  learnerHeartbeatAt DateTime?
  acceptedAt         DateTime?
  endedAt            DateTime?
  expiresAt          DateTime
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([learnerId, status, createdAt])
  @@index([linkId, status, createdAt])
  @@index([status, expiresAt, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Deck {
  id                 Int                 @id @default(autoincrement())
  name               String
  description        String?             @db.VarChar(500)
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  Card               Card[]
  fsrsConfig         DeckFsrsConfig?
  reviewLogs         CardReviewLog[]
  createdAt          DateTime            @default(now())
  writingSubmissions WritingSubmission[] // Added relation to WritingSubmission

  @@unique([name, userId])
  @@index([userId])
}

model Card {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  paused      Boolean  @default(false)
  term        String
  definition  String
  createdAt   DateTime @default(now())
  imageBlobId String?
  deckId      Int
  Deck        Deck     @relation(fields: [deckId], references: [id])
  lastFailure Float    @default(0)
  // Scheduling/stat fields migrated from Quiz (speaking)
  stability   Float    @default(0)
  difficulty  Float    @default(0)
  firstReview Float    @default(0)
  lastReview  Float    @default(0)
  nextReview  Float    @default(0)
  lapses      Float    @default(0)
  repetitions Float    @default(0)
  reviewLogs          CardReviewLog[]
  reviewLogCoverage   String?
  reviewLogStartedAt  DateTime?
  lastPassiveReviewAt DateTime? @map("last_passive_review_at")
  importedReaderHighlights ReaderArticleHighlight[] @relation("ImportedHighlightCard")
  importedReaderBookAnnotations ReaderBookAnnotation[] @relation("ImportedBookAnnotationCard")

  @@unique([userId, term])
  @@index([deckId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, paused])
  @@index([userId, nextReview])
  @@index([userId, deckId, lastPassiveReviewAt])
}

model DeckFsrsConfig {
  id                 Int      @id @default(autoincrement())

  deckId             Int      @unique
  deck               Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)

  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  requestedRetention Float
  parametersJson     Json
  parametersSource   String
  tsFsrsVersion      String
  schedulerFlagsJson Json

  lastOptimizedAt    DateTime?
  lastOptimizedLogId BigInt?
  logsSinceOptimize  Int      @default(0)
  eligibleLogCount   Int      @default(0)
  optimizerStatus    String?
  optimizerError     String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reviewLogs         CardReviewLog[]

  @@index([userId])
}

model CardReviewLog {
  id                 BigInt   @id @default(autoincrement())

  userId             String
  deckId             Int
  deckFsrsConfigId   Int
  cardId             Int

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck               Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckFsrsConfig     DeckFsrsConfig @relation(fields: [deckFsrsConfigId], references: [id], onDelete: Cascade)
  card               Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  reviewAt           DateTime
  rating             Int

  completeness       String

  rawLogJson         Json
  cardBeforeJson     Json?
  cardAfterJson      Json?

  dueAt              DateTime?
  scheduledDays      Float?
  elapsedDays        Float?
  stabilityBefore    Float?
  stabilityAfter     Float?
  difficultyBefore   Float?
  difficultyAfter    Float?

  tsFsrsVersion      String
  createdAt          DateTime @default(now())

  @@index([deckId, reviewAt])
  @@index([deckFsrsConfigId, reviewAt])
  @@index([cardId, reviewAt])
  @@index([userId, deckId, reviewAt])
}

model QuizResult {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
  definition     String
  acceptableTerm String
  userInput      String
  isAcceptable   Boolean  @default(false)
  reason         String
  eventType      String   @default("speaking-judgement")
  reviewedAt     DateTime?
  helpfulness    Int      @default(0)
  errorTag       String?  @db.VarChar(20)

  @@index([createdAt])
  @@index([userId, createdAt])
}

model WritingSubmission {
  id                       Int      @id @default(autoincrement())
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                   String
  deck                     Deck?    @relation(fields: [deckId], references: [id], onDelete: SetNull)
  deckId                   Int?
  prompt                   String
  submission               String   @db.Text // Use Text for potentially long submissions
  submissionCharacterCount Int
  correction               String   @db.Text // Use Text for potentially long corrections
  correctionCharacterCount Int
  createdAt                DateTime @default(now())

  @@index([userId])
  @@index([deckId])
  @@index([userId, createdAt]) // For querying daily progress
  @@index([userId, deckId, createdAt])
}

enum ReaderIngestStatus {
  PENDING
  IN_PROGRESS
  READY
  ERROR
}

enum ReaderInputKind {
  URL
  RAW
}

enum ReaderHighlightStatus {
  IN_PROGRESS
  READY
  ERROR
}

model ReaderInstapaperCredential {
  id                    Int      @id @default(autoincrement())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instapaperUsername    String   @db.VarChar(200)
  encryptedAccessToken  String   @db.Text
  encryptedAccessSecret String   @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model ReaderArticle {
  id            Int                @id @default(autoincrement())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicId      String             @unique @default(cuid())
  instapaperBookmarkId String?     @db.VarChar(64)
  requestUrl    String?            @db.Text
  normalizedUrl String?            @db.Text
  inputKind     ReaderInputKind    @default(URL)
  title         String             @db.Text
  description   String             @db.Text
  ingestStatus  ReaderIngestStatus @default(PENDING)
  ingestError   String             @default("") @db.Text
  ingestStartedAt DateTime?
  ingestedAt    DateTime?
  contentText   String             @db.Text
  contentHtml   String             @db.Text
  readAt        DateTime?
  lastReadAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  highlights    ReaderArticleHighlight[]

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, lastReadAt])
  @@index([publicId])
  @@index([userId, instapaperBookmarkId])
  @@index([ingestStatus, createdAt])
}

model ReaderArticleHighlight {
  id                      Int                   @id @default(autoincrement())
  userId                  String
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId               Int
  article                 ReaderArticle         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  selectedText            String                @db.Text
  selectedTextHash        String                @db.VarChar(64)
  selectedOccurrenceIndex Int
  occurrenceCount         Int
  occurrencesJson         Json
  articleContentHash      String                @db.VarChar(64)
  promptVersion           Int                   @default(1)
  status                  ReaderHighlightStatus @default(IN_PROGRESS)
  term                    String                @default("") @db.Text
  definition              String                @default("") @db.Text
  generalMeaning          String                @default("") @db.Text
  meaningInContext        String                @default("") @db.Text
  errorMessage            String                @default("") @db.Text
  importedCardId          Int?
  importedCard            Card?                 @relation("ImportedHighlightCard", fields: [importedCardId], references: [id], onDelete: SetNull)
  importedAt              DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([userId, articleId, createdAt])
  @@index([articleId, createdAt])
  @@index([importedCardId])
  @@unique([userId, articleId, selectedTextHash, selectedOccurrenceIndex, articleContentHash, promptVersion])
}

model ReaderBook {
  id               Int                    @id @default(autoincrement())
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicId         String                 @unique @default(cuid())
  fingerprint      String                 @db.VarChar(512)
  title            String                 @db.Text
  author           String                 @default("") @db.Text
  description      String                 @default("") @db.Text
  language         String                 @default("") @db.VarChar(32)
  opfIdentifier    String                 @default("") @db.Text
  fileName         String                 @db.Text
  fileSize         BigInt
  fileLastModified BigInt
  coverPath        String                 @default("") @db.Text
  navigationJson   Json
  spineJson        Json
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  progress         ReaderBookProgress?
  annotations      ReaderBookAnnotation[]

  @@unique([userId, fingerprint])
  @@index([userId, createdAt])
  @@index([publicId])
}

model ReaderBookProgress {
  id                  Int        @id @default(autoincrement())
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId              Int        @unique
  book                ReaderBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  lastLocatorJson     Json
  furthestLocatorJson Json
  lastOpenedAt        DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([userId, lastOpenedAt])
}

model ReaderBookAnnotation {
  id                      Int                   @id @default(autoincrement())
  userId                  String
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId                  Int
  book                    ReaderBook            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  locatorJson             Json
  chapterTitle            String                @default("") @db.Text
  progression             Float                 @default(0)
  quote                   String                @db.Text
  contextBefore           String                @default("") @db.Text
  contextAfter            String                @default("") @db.Text
  selectedTextHash        String                @db.VarChar(64)
  selectedOccurrenceIndex Int
  occurrenceCount         Int
  occurrencesJson         Json
  sectionTextHash         String                @db.VarChar(64)
  promptVersion           Int                   @default(1)
  status                  ReaderHighlightStatus @default(IN_PROGRESS)
  term                    String                @default("") @db.Text
  definition              String                @default("") @db.Text
  generalMeaning          String                @default("") @db.Text
  meaningInContext        String                @default("") @db.Text
  errorMessage            String                @default("") @db.Text
  importedCardId          Int?
  importedCard            Card?                 @relation("ImportedBookAnnotationCard", fields: [importedCardId], references: [id], onDelete: SetNull)
  importedAt              DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([userId, bookId, createdAt])
  @@index([bookId, createdAt])
  @@index([importedCardId])
  @@unique([userId, bookId, selectedTextHash, selectedOccurrenceIndex, sectionTextHash, promptVersion])
}
