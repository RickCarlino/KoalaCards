{
  "name": "koala-cards",
  "version": "1.1.0-alpha",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true
  },
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3000 --hostname 0.0.0.0",
    "dupcheck": "jscpd --threshold 2 --pattern \"**/*.{ts,tsx,js,jsx}\" pages koala test",
    "lint": "eslint pages/",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/register-typescript-loader.mjs --test test/*.test.ts",
    "test:coverage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/register-typescript-loader.mjs --test --experimental-test-coverage test/*.test.ts",
    "verify:openai": "tsx scripts/verify-openai-models.ts",
    "reset": "rm -rf node_modules && rm -rf package-lock.json && npm install && npx prisma migrate dev && tsx seeds/ingest.ts",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "start": "npm run db:migrate:deploy && next start",
    "start:no-migrate": "next start",
    "worker": "tsx koala/worker/main.ts",
    "format": "prettier --write pages/ && prettier --write koala/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint-plugin-no-else-if": "^1.0.0",
    "jscpd": "^5.0.16",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google-cloud/language": "^8.0.1",
    "@google-cloud/storage": "^8.0.1",
    "@google-cloud/text-to-speech": "^7.0.0",
    "@mantine/charts": "^9.5.2",
    "@mantine/core": "^9.5.2",
    "@mantine/form": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@mantine/modals": "^9.5.2",
    "@mantine/notifications": "^9.5.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@open-spaced-repetition/binding": "^0.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.3",
    "@trpc/client": "^11.18.0",
    "@trpc/next": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@zip.js/zip.js": "^2.8.59",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "next": "^16.3.3",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "radash": "^12.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "superjson": "^2.2.6",
    "ts-fsrs": "^5.4.1",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  }
}
